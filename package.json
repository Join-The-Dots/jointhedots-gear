{
   "name": "@jointhedots/gear",
   "version": "1.2.6",
   "type": "module",
   "packageManager": "pnpm@10.30.3",
   "bin": {
      "jointhedots-gear": "esm/cli.js"
   },
   "exports": {
      "./workspace": "./esm/workspace/mod.js",
      "./core": {
         "browser": "./esm/core/mod-browser.js",
         "node": "./esm/core/mod-node.js",
         "deno": "./src/core/mod.ts",
         "default": "./esm/core/mod.js"
      }
   },
   "files": [
      "esm",
      "browser-modules",
      "schemas",
      "!**/*.map"
   ],
   "scripts": {
      "watch": "tsc -w --sourceMap",
      "test": "tsx --watch=src src/core/test.ts",
      "build": "tsc",
      "test:load":"tsx --watch=src --watch-path=esm src/cli load --dir ./dist/jointhedots-ui",
      ":serve": "tsx --watch=src src/cli serve --app playground:agent --devmode --port 3001 --ws ../jointhedots-core/packages/jointhedots-agent",
      ":build:core": "tsx --watch=src src/cli make --buns jointhedots.core --devmode --ws ../jointhedots-core/packages/jointhedots-core",
      ":build:ui": "tsx --watch=src src/cli make --buns jointhedots.ui --devmode --ws ../jointhedots-core/packages/jointhedots-ui",
      ":build:cortex": "tsx --watch=src src/cli make --buns @jointhedots/cortex --devmode --ws ../jointhedots-core/packages/jointhedots-cortex",
      ":build:libs": "tsx --watch=src src/cli make --libs @jointhedots/core,@jointhedots/ui --devmode --ws ../jointhedots-core",
      ":build:lib:core": "tsx --watch=src src/cli make --libs @jointhedots/core --devmode --ws ../jointhedots-core/packages/jointhedots-core",
      ":build:lib:ui": "tsx --watch=src src/cli make --libs @jointhedots/ui --devmode --ws ../jointhedots-core/packages/jointhedots-ui",
      ":build:app": "tsx --watch=src src/cli make --apps playground:ui --ws ../jointhedots-core",
      "serve:mono": "tsx --watch=src src/cli serve --app playground:ui --devmode --port 3002 --ws ../jointhedots-core",
      "serve:host": "tsx --watch=src src/cli serve --app playground:ui:host --devmode --port 3002 --ws ../jointhedots-core",
      "serve:sfe": "tsx --watch=src src/cli serve --app sfe-demo --devmode --ws ../sf-explorer-app",
      "serve:demo": "tsx --watch=src src/cli serve --app sfe-demo --devmode --ws ../sf-explorer-demo",
      "make:sfe": "tsx --watch=src src/cli make --libs @sf-explorer/app --devmode --ws ../sf-explorer-app",
      "prepublishOnly": "node scripts/prepublish.mjs"
   },
   "dependencies": {
      "@jspm/core": "^2.1.0",
      "@tailwindcss/postcss": "~4.1.3",
      "@typescript/native-preview": "^7.0.0-dev.20260310.1",
      "dotenv": "~17.2.3",
      "esbuild": "~0.27.2",
      "esbuild-sass-plugin": "~3.6.0",
      "express": "~5.2.1",
      "json-schema": "^0.4.0",
      "mime": "~4.1.0",
      "postcss": "~8.5.6",
      "sass": "~1.97.2",
      "semver": "~7.7.3",
      "sharp": "~0.34.5",
      "toml": "^3.0.0",
      "typescript": "~5.9.3",
      "vscode-uri": "^3.1.0",
      "yaml": "^2.8.2",
      "yargs": "~18.0.0",
      "zod": "^4.3.6"
   },
   "devDependencies": {
      "@polycuber/script.cli": "~1.0.5",
      "@types/chrome": "~0.1.40",
      "@types/node": "~22.7.4",
      "@types/semver": "~7.7.1",
      "@types/web-app-manifest": "~1.0.9",
      "@types/yargs": "~17.0.35"
   },
   "bundleDependencies": [
      "@deno/esbuild-plugin",
      "@jspm/core"
   ]
}