{
  "compilerOptions": {
    "target": "es2022",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "rewriteRelativeImportExtensions": true,
    "allowArbitraryExtensions": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noUnusedLocals": false,
    "noImplicitThis": true,
    "sourceMap": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "esm",
    "jsx": "react-jsx",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "esm",
    "node_modules",
    "scripts"
  ]
}